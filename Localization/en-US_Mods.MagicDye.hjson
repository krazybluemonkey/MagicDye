UI: {
	PrimaryColor: Primary Color
	SecondaryColor: Secondary Color
	Saturation: Saturation
	Opacity: Opacity
	ResearchToolTip:
		'''
		Insert dyes to research
		Insert magic dyes to change slots
		'''
	CopyToolTip: Copy dye template to clipboard
	PasteToolTip: Paste dye template from clipboard
	WorkingSlotToolTip: Current Magic Dye Slot
	ColorPageToolTip: Colors & Modifiers
	ResearchPageToolTip: Research & Templates
	Pass: Pass
	ColorModOne: Color Modifier #1
	ColorModTwo: Color Modifier #2
	Templates: Templates

	Filters: {
		Filter: Filter
		Vanilla: Terraria
		All: All
	}

	Information: {
		PasteInvalidJSONError: The template JSON in your Clipboard is malformed or invalid.
		PasteJSONSizeError: The template JSON in your Clipboard is larger or smaller then expected.
		PasteJSONVersionError: The version of your Clipboards' template JSON is invalid.
		PasteInvalidPassError: The Pass in your Clipboards' template JSON is invalid.
		PasteInvalidPassUnresearchedError: The Pass in your Clipboards' template JSON is either unresearched or invalid.
		PasteInvalidColorModifierError: One of the Color Modifiers in your Clipboards' template JSON are either unresearched or invalid.
		PasteInvalidColorModifierUnresearchedError: One of the Color Modifiers in your Clipboards' template JSON are either unresearched or invalid.
		PasteInvalidColorError: One of the colors in your Clipboards' template JSON is invalid.
		PasteInvalidSaturationError: The Saturation in your Clipboards' template JSON is invalid.
		PasteInvalidOpacityError: The Opacity in your Clipboards' template JSON is invalid.
		PasteUnspecifiedError: An unspecified error has occurred. Ensure your template JSON is formatted correctly and try again.
		CopySuccess: Copied!
		PasteSuccess: Pasted!
	}
}

Logs: {
	UnloadedWarn: MagicDye Slot {0} pass for {1} is from an unloaded mod. the dye will display oddly until the mod is re-enabled.
